# Server
SERVER_PORT=5000
NODE_ENV=test

OFFICE_TIMEZONE=Europe/Kyiv

# Auth
# 30 * 60 * 1000            30m
ACCESS_TOKEN_TTL=1800000
# 30 * 24 * 60 * 60 * 1000  30d
REFRESH_TOKEN_TTL=2592000000
# 15 * 60 * 1000            15m
ACTIVATION_LINK_TTL=900000

ACCESS_TOKEN_SECRET=access_test_secret
REFRESH_TOKEN_SECRET=refresh_test_secret

GOOGLE_CLIENT_ID=test_id
GOOGLE_CLIENT_SECRET=test_secret
GOOGLE_CALLBACK_URL=http://localhost:5000/auth/google/callback

# Reservations
# 0 to disable
PREVENT_CANCELLATION_BEFORE_MINUTES=15
NOTIFY_BEFORE_MINUTES=10

# Frontend
DOMAIN=undefined
CLIENT_URL=http://localhost:3000
PROFILE_ROUTE=/




